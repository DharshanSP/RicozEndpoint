# ─── Database ─────────────────────────────────────────────────────────────────
# docker-compose exposes 5433 on the host (5432 inside the container network).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ricoz_endpoint
# Production (Render / Supabase / Neon): paste the pooled connection string here.
# Example: DATABASE_URL=postgresql://user:password@host:5432/postgres?pgbouncer=true

# ─── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string-in-production
JWT_EXPIRY=12h
# Public tenant signup (POST /api/auth/register). Set to false in production
# once initial organizations exist to close open registration.
ALLOW_PUBLIC_SIGNUP=true

# ─── API Server ─────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
APP_VERSION=0.1.0

# ─── CORS (comma-separated allow-list; empty denies cross-origin in production) ─
CORS_ORIGIN=http://localhost:5173

# ─── Agent Enrollment ───────────────────────────────────────────────────────
AGENT_ENROLLMENT_SECRET=change-me-to-a-secure-random-string-in-production
# Package downloaded by GET /api/agent/install.ps1 (the PowerShell installer
# snippet). Defaults to the latest GitHub Release ZIP when unset.
#AGENT_DOWNLOAD_URL=https://github.com/DharshanSP/RicozEndpoint/releases/latest/download/RicozEndpointAgent.zip

# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
# Optional override. Local dev defaults to http://localhost:3001/api; any
# non-localhost deployment defaults to https://ricoz-api.onrender.com/api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Production: CORS_ORIGIN=https://ricz-endpoint.vercel.app

# Windows agent download (GitHub Release asset URL). When unset, the web app
# falls back to the locally built /downloads/RicozEndpointAgent.exe.
#NEXT_PUBLIC_AGENT_DOWNLOAD_URL=https://github.com/DharshanSP/RicozEndpoint/releases/latest/download/RicozEndpointAgent.zip
