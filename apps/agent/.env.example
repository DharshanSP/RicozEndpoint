# RicozEndpoint agent configuration
# Copy to .env and adjust for your environment.

# Base URL of the RicozEndpoint API
API_URL=http://localhost:3001/api

# Enrollment token issued from the platform (used only for first registration)
ENROLLMENT_TOKEN=

# Heartbeat interval in milliseconds (default 60000)
HEARTBEAT_INTERVAL_MS=60000

# How often hardware/software inventory telemetry is sent in ms (default 600000)
TELEMETRY_INTERVAL_MS=600000

# Agent version reported to the platform
AGENT_VERSION=0.1.0

# Override where the agent persists its credentials
# (default: %APPDATA%\RicozEndpoint\agent.json on Windows)
#AGENT_STATE_FILE=

# Connection & retry handling
# Per-request HTTP timeout in ms (default 30000). Increase on slow links.
AGENT_REQUEST_TIMEOUT_MS=30000
# Base exponential-backoff delay after a failed heartbeat in ms (default 5000)
AGENT_BACKOFF_BASE_MS=5000
# Maximum backoff delay in ms (default 300000 = 5 min)
AGENT_BACKOFF_MAX_MS=300000
# Command-result report retries before queueing for the next heartbeat (default 3)
AGENT_RESULT_RETRIES=3