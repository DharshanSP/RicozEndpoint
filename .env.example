# Database (docker-compose exposes 5433 on the host; 5432 inside the container network)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ricoz_endpoint

# Authentication
JWT_SECRET=change-me-to-a-secure-random-string-in-production
JWT_EXPIRY=12h

# API Server
API_PORT=3001
NODE_ENV=development
APP_VERSION=0.1.0

# CORS (comma-separated allow-list; empty denies cross-origin in production)
CORS_ORIGIN=http://localhost:5173

# Agent Enrollment
AGENT_ENROLLMENT_SECRET=change-me-to-a-secure-random-string-in-production

# Frontend
VITE_API_URL=http://localhost:3001/api
# Production: VITE_API_URL=https://ricoz-api.onrender.com/api
# Production: CORS_ORIGIN=https://<your-vercel-app>.vercel.app

# Agent Enrollment
AGENT_ENROLLMENT_SECRET=change-me-to-a-secure-random-string-in-production

# Frontend
VITE_API_URL=http://localhost:3001/api

# Windows agent download (GitHub Release asset URL). When unset, the web app
# falls back to the locally built /downloads/RicozEndpointAgent.exe.
#VITE_AGENT_DOWNLOAD_URL=https://github.com/DharshanSP/RicozEndpoint/releases/latest/download/RicozEndpointAgent.zip
