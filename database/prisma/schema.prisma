generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization ────────────────────────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid())
  name         String   @unique
  settingsJson Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  devices      Device[]
  policies     Policy[]
  commands     Command[]
  applications Application[]
  deployments  Deployment[]
  patches      Patch[]
  alerts       Alert[]
  auditLogs          AuditLog[]
  agentTokens        AgentToken[]
  deviceGroups       DeviceGroup[]
  enrollmentTokens   EnrollmentToken[]

  @@map("organizations")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("VIEWER")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id])
  auditLogs             AuditLog[]
  requestedCommands     Command[]    @relation("RequestedBy")
  requestedDeployments  Deployment[] @relation("RequestedDeployments")
  createdEnrollmentTokens EnrollmentToken[] @relation("CreatedEnrollmentTokens")
  createdPolicies       Policy[]
  createdPatches        Patch[]        @relation("CreatedPatches")

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─── Device ──────────────────────────────────────────────────────────────────

model Device {
  id             String    @id @default(uuid())
  organizationId String
  deviceName     String
  hostname       String
  serialNumber   String
  manufacturer   String    @default("")
  model          String    @default("")
  os             String
  osVersion      String
  architecture   String
  ipAddress      String    @default("")
  agentVersion   String    @default("")
  status         String    @default("PENDING")
  lastSeenAt     DateTime?
  registeredAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  firewallEnabled Boolean?
  antivirusEnabled Boolean?

  organization      Organization        @relation(fields: [organizationId], references: [id])
  hardware          DeviceHardware?
  software          DeviceSoftware[]
  heartbeats        DeviceHeartbeat[]
  commands          Command[]
  policies          PolicyAssignment[]
  complianceResults ComplianceResult[]
  alerts            Alert[]
  agentTokens       AgentToken[]
  patches           DevicePatch[]
  deviceGroups      DeviceGroupMember[]
  enrollmentTokens  EnrollmentToken[]
  deployments       Deployment[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("devices")
}

// ─── Device Hardware ─────────────────────────────────────────────────────────

model DeviceHardware {
  id           String   @id @default(uuid())
  deviceId     String   @unique
  cpu          String
  cpuCores     Int
  ramBytes     BigInt
  storageBytes BigInt
  freeStorageBytes BigInt?
  manufacturer String
  model        String
  serialNumber String
  biosVersion  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_hardware")
}

// ─── Device Software ─────────────────────────────────────────────────────────

model DeviceSoftware {
  id           String    @id @default(uuid())
  deviceId     String
  name         String
  version      String
  publisher    String
  installDate  DateTime?
  architecture String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([name])
  @@map("device_software")
}

// ─── Device Heartbeat ────────────────────────────────────────────────────────

model DeviceHeartbeat {
  id           String   @id @default(uuid())
  deviceId     String
  agentVersion String
  timestamp    DateTime
  status       String
  createdAt    DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([createdAt])
  @@map("device_heartbeats")
}

// ─── Device Group ────────────────────────────────────────────────────────────

model DeviceGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  devices      DeviceGroupMember[]
  policies     PolicyAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("device_groups")
}

model DeviceGroupMember {
  id       String @id @default(uuid())
  groupId  String
  deviceId String

  group  DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  device Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([groupId, deviceId])
  @@map("device_group_members")
}

// ─── Policy ──────────────────────────────────────────────────────────────────

model Policy {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String
  description    String   @default("")
  settings       String   @default("{}")
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments  PolicyAssignment[]

  @@index([organizationId])
  @@index([createdById])
  @@map("policies")
}

// ─── Policy Assignment ───────────────────────────────────────────────────────

model PolicyAssignment {
  id        String   @id @default(uuid())
  policyId  String
  deviceId  String?
  groupId   String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  policy Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  device Device?      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  group  DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([deviceId])
  @@index([groupId])
  @@map("policy_assignments")
}

// ─── Compliance ──────────────────────────────────────────────────────────────

model ComplianceRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String   @default("")
  ruleType       String
  condition      String   @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  results ComplianceResult[]

  @@index([organizationId])
  @@map("compliance_rules")
}

model ComplianceResult {
  id          String   @id @default(uuid())
  deviceId    String
  ruleId      String?
  status      String
  reason      String   @default("")
  evaluatedAt DateTime

  device Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rule   ComplianceRule? @relation(fields: [ruleId], references: [id])

  @@index([deviceId])
  @@index([evaluatedAt])
  @@map("compliance_results")
}

// ─── Command ─────────────────────────────────────────────────────────────────

model Command {
  id             String    @id @default(uuid())
  organizationId String
  deviceId       String
  type           String
  status         String    @default("QUEUED")
  requestedBy    String?
  patchId        String?
  deploymentId   String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  result         String?
  errorMessage   String?

  organization Organization @relation(fields: [organizationId], references: [id])
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requester    User?        @relation("RequestedBy", fields: [requestedBy], references: [id])
  deployment   Deployment?  @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([status])
  @@index([patchId])
  @@index([deploymentId])
  @@index([createdAt])
  @@map("commands")
}

// ─── Application ─────────────────────────────────────────────────────────────

model Application {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  version        String
  description    String   @default("")
  publisher      String   @default("")
  installerUrl   String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  deployments  Deployment[]

  @@index([organizationId])
  @@map("applications")
}

model Deployment {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String
  deviceId       String
  action         String   @default("INSTALL")
  status         String   @default("PENDING")
  requestedBy    String?
  errorMessage   String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  requester   User?        @relation("RequestedDeployments", fields: [requestedBy], references: [id])
  commands    Command[]

  @@index([organizationId])
  @@index([applicationId])
  @@index([deviceId])
  @@index([status])
  @@map("deployments")
}

// ─── Alert ───────────────────────────────────────────────────────────────────

model Alert {
  id             String    @id @default(uuid())
  organizationId String
  deviceId       String?
  type           String    @default("")
  /// Stable de-duplication key (e.g. `policy:<id>`, `offline:<deviceId>`).
  dedupKey       String?
  severity       String
  title          String
  message        String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedNote   String?

  organization Organization @relation(fields: [organizationId], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id])

  @@index([organizationId])
  @@index([deviceId])
  @@index([severity])
  @@index([status])
  @@index([organizationId, type, status])
  @@map("alerts")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  /// Null for system-initiated events (agent enrollment, scheduled evaluations) that
  /// have no authenticated human actor.
  actorId        String?
  action         String
  resource       String
  resourceId     String
  timestamp      DateTime @default(now())
  ipAddress      String   @default("")
  metadata       String?

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── Enrollment Token ────────────────────────────────────────────────────────

model EnrollmentToken {
  id             String    @id @default(uuid())
  organizationId String
  tokenHash      String    @unique
  label          String    @default("")
  createdById    String?
  deviceId       String?
  expiresAt      DateTime?
  maxUses       Int       @default(1)
  uses          Int       @default(0)
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation("CreatedEnrollmentTokens", fields: [createdById], references: [id])
  device       Device?      @relation(fields: [deviceId], references: [id])

  @@index([organizationId])
  @@index([tokenHash])
  @@map("enrollment_tokens")
}

// ─── Agent Token ─────────────────────────────────────────────────────────────

model AgentToken {
  id             String    @id @default(uuid())
  organizationId String
  deviceId       String
  tokenHash      String    @unique
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([deviceId])
  @@map("agent_tokens")
}


// ============================== Patch Catalog ================================

model Patch {
  id             String    @id @default(uuid())
  organizationId String
  kbNumber       String
  title          String
  description    String    @default("")
  severity       String    @default("IMPORTANT")
  category       String    @default("Security Updates")
  status         String    @default("PENDING")
  releaseDate    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation("CreatedPatches", fields: [createdById], references: [id])
  devices      DevicePatch[]

  @@unique([organizationId, kbNumber])
  @@index([organizationId])
  @@index([organizationId, severity])
  @@index([organizationId, status])
  @@map("patches")
}

// ============================ Device Patch State =============================

model DevicePatch {
  id             String    @id @default(uuid())
  deviceId       String
  patchId        String
  status         String    @default("MISSING")
  installedAt    DateTime?
  lastReportedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  patch  Patch  @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@unique([deviceId, patchId])
  @@index([deviceId])
  @@index([patchId])
  @@index([status])
  @@map("device_patches")
}
